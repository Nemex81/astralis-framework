# Normalize text files in the repository.
* text=auto

# Cross-platform documentation and configuration use LF.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.sh text eol=lf

# PowerShell files use Windows line endings.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binary files must never be line-ending normalized.
*.zip binary
*.7z binary
*.rar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
